{
  "name": "indirme-yoneticisi",
  "private": true,
  "version": "0.0.3",
  "description": "tarus indirme yöneticisi — hızlı ve açık kaynak kodlu indirme yöneticisi",
  "author": "tarusatolye <yazilim@tarus.tr>",
  "copyright": "Copyright © 2026 tarusatolye",
  "repository": {
    "type": "git",
    "url": "https://github.com/tarusatolye/indirme-yoneticisi.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.cjs",
    "start": "electron electron/main.cjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "dist:mac": "npm run build && electron-builder --mac dmg zip"
  },
  "build": {
    "appId": "tr.tarus.indirmeyoneticisi",
    "productName": "Indirme Yoneticisi",
    "copyright": "Copyright © 2026 tarusatolye",
    "publish": [
      {
        "provider": "github",
        "owner": "tarusatolye",
        "repo": "indirme-yoneticisi"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": "Extension",
        "to": "Extension"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "docs/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "İndirme Yöneticisi",
      "license": "build/license.txt"
    },
    "protocols": [
      {
        "name": "Indirme Yoneticisi",
        "schemes": [
          "indirmeyoneticisi",
          "tarus-dm"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "docs/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "Indirme-Yoneticisi-${version}-mac.${ext}",
      "extendInfo": {
        "CFBundleDisplayName": "İndirme Yöneticisi"
      }
    },
    "dmg": {
      "title": "Indirme Yoneticisi",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
